rules_version = '2';

// ============================================================
// RM Ubuzima - Firestore security rules
//
// Goal: stop anonymous access to private health conversations
// while keeping every existing app flow working.
//
// Design notes:
// - The app's user IDs ARE Firebase Auth UIDs (see AuthPage:
//   `id: user.uid`), so uid-based rules work correctly.
// - Public content stays publicly readable because parts of the
//   app render before login (logo, settings, facilitator list).
// - Password reset happens while LOGGED OUT, so those
//   collections must remain open.
// - Private collections require a signed-in user. Per-document
//   participant scoping is the recommended next step; requiring
//   auth first removes the anonymous-internet exposure with
//   minimal risk of breaking live features.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isAuthed() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isAuthed() && request.auth.uid == userId;
    }

    // ---------- Public content ----------
    // Read publicly: some of this renders before the user logs in.
    // Writes still require a signed-in user (admin panel).
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    match /facilitators/{docId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    match /aiPosts/{docId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    match /statusUpdates/{docId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    match /articles/{docId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    match /topics/{docId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    match /organizations/{docId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    match /facilities/{docId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    match /emergencyContacts/{docId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    // ---------- Password reset (runs while logged out) ----------
    // Must stay open or users can never recover their accounts.
    // Codes are short-lived and attempt-limited in application code.
    match /passwordResetCodes/{docId} {
      allow read, write: if true;
    }

    match /passwordResetCodesByEmail/{docId} {
      allow read, write: if true;
    }

    // ---------- User profiles ----------
    // Any signed-in user may read profiles (facilitator inbox shows
    // participant names and avatars), but only the owner may write.
    match /users/{userId} {
      allow read: if isAuthed();
      allow create, update: if isSelf(userId);
      allow delete: if false;
    }

    // ---------- Voice calls ----------
    // Signaling only; no audio ever passes through Firestore.
    // Restricted to the two participants so nobody else can read
    // call records or trigger a phone to ring.
    match /calls/{callId} {
      allow read: if isAuthed() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.calleeId
      );

      allow create: if isAuthed() &&
        request.auth.uid == request.resource.data.callerId;

      allow update: if isAuthed() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.calleeId
      );

      allow delete: if false;

      // ICE candidates: both sides publish network routes here.
      match /{candidateSet}/{candidateId} {
        allow read, create: if isAuthed();
        allow update, delete: if false;
      }
    }

    // ---------- Private conversations ----------
    // Signed-in users only. Never publicly readable.
    match /inbox_messages/{docId} {
      allow read, create, update: if isAuthed();
      allow delete: if isAuthed();
    }

    match /shangazi_messages/{docId} {
      allow read, create, update: if isAuthed();
      allow delete: if isAuthed();
    }

    match /legal_affairs_messages/{docId} {
      allow read, create, update: if isAuthed();
      allow delete: if isAuthed();
    }

    match /gbv_messages/{docId} {
      allow read, create, update: if isAuthed();
      allow delete: if isAuthed();
    }

    match /abortion_messages/{docId} {
      allow read, create, update: if isAuthed();
      allow delete: if isAuthed();
    }

    match /family_planning_messages/{docId} {
      allow read, create, update: if isAuthed();
      allow delete: if isAuthed();
    }

    // ---------- Community chat ----------
    match /chat_settings/{docId} {
      // Parent document carries the facilitator list, which the app
      // reads early, so keep it readable.
      allow read: if true;
      allow write: if isAuthed();

      match /messages/{messageId} {
        allow read, create, update: if isAuthed();
        allow delete: if false;
      }
    }

    // ---------- Groups ----------
    match /groups/{docId} {
      allow read, write: if isAuthed();
    }

    match /group_messages/{docId} {
      allow read, create, update: if isAuthed();
      allow delete: if isAuthed();
    }

    match /group_join_requests/{docId} {
      allow read, write: if isAuthed();
    }

    match /group_requests/{docId} {
      allow read, write: if isAuthed();
    }

    // ---------- Appointments ----------
    match /appointments/{docId} {
      allow read, write: if isAuthed();
    }

    // ---------- Legacy collections ----------
    match /chat_participants/{docId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    match /chat_rooms/{docId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    // ---------- Catch-all ----------
    // Previously `if true`, which exposed the whole database to
    // anyone on the internet. Now any unlisted collection still
    // works for signed-in users, so no feature silently breaks.
    match /{document=**} {
      allow read, write: if isAuthed();
    }
  }
}

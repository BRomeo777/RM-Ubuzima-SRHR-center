rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    // User profiles - users can read/write their own data only
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }
    
    // Settings - anyone can read, only admin can write
    match /settings/{document} {
      allow read: if true;  // Public: logo, app email, AI avatars
      allow write: if isAdmin();
    }
    
    // AI Posts - anyone can read, authenticated users can create
    match /aiPosts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // Status Updates - anyone can read, only admin can write
    match /statusUpdates/{updateId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Organizations - anyone can read, only admin can write
    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Emergency Contacts - anyone can read, only admin can write
    match /emergencyContacts/{contactId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Appointments - anyone can create (for booking), admin can read/update/delete
    match /appointments/{appointmentId} {
      allow read: if isAdmin();  // Only admin can view all appointments
      allow create: if true;     // Anyone can book an appointment
      allow update, delete: if isAdmin();  // Only admin can modify appointments
    }
    
    // Chat Settings - public read for facilitators list, admin-only write
    match /chat_settings/{document} {
      allow read: if true;  // Public: needed for facilitator list, banned users
      allow write: if isAdmin();  // Only admin can modify chat settings
    }
    
    // Chat messages - public read/write for global chat
    match /chat_settings/{document}/messages/{messageId} {
      allow read: if true;
      allow create: if isAuthenticated() || true;  // Allow anonymous chat
      allow update: if isAdmin() || isAuthenticated();  // For soft-delete
      allow delete: if isAdmin();
    }
    
    // Inbox/Direct Messages - users can read/write messages they're part of
    match /inbox_messages/{messageId} {
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.senderId || 
         request.auth.uid == resource.data.receiverId);
      allow create: if isAuthenticated() && 
        request.auth.uid == request.resource.data.senderId;
      allow update: if isAuthenticated() && 
        (request.auth.uid == resource.data.senderId || 
         request.auth.uid == resource.data.receiverId);
      allow delete: if isAdmin();
    }
    
    // Facilitators collection - public read for facilitator list, admin-only write
    match /facilitators/{facilitatorId} {
      allow read: if true;  // Public: needed for facilitator directory
      allow write: if isAdmin();  // Only admin can add/modify facilitators
    }
    
    // Legacy collections support - allow admin access
    match /chat_participants/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /chat_rooms/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Fallback - deny access to any unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

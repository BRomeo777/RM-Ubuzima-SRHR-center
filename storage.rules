rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Logo folder - anyone can read/write (admin controlled via UI)
    match /logos/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    
    // Avatars folder - anyone can read/write (admin controlled via UI)  
    match /avatars/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    
    // Carousel folder - anyone can read/write (admin controlled via UI)
    match /carousel/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    
    // User uploads - users can read/write their own files
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
